# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
# Remote content built by RemoteContent (uploaded to R2) and its upload keys
/ServerData/
/Tools/r2.env
# Google Play upload key passwords (keystore itself lives in ~/.lumaquarium)
/Tools/android.env
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools plugin
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Blender backup files
*.blend1
*.blend2

# macOS
.DS_Store

# Python bytecode from Tools scripts
__pycache__/

# Scene copies the editor builders write before changing a scene
/Backups/

# Cloud Code module (CloudCode/): its project and solution files are source, its build output is not
!/CloudCode/**/*.csproj
!/CloudCode/**/*.sln
/CloudCode/**/bin/
/CloudCode/**/obj/
/CloudCode/**/*.ccm
